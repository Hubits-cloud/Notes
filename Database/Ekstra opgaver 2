Spørgsmål: Lav en liste af alle bøger, dens forfatter og title, som starter med ”the” og ikke har en publisher.
SELECT b.book_id, b.title, COALESCE(CONCAT(a.first_name, ' ', a.last_name), 'No Author') AS author_name FROM Books b LEFT JOIN Authors a ON a.author_id = b.author_id LEFT JOIN Book_Publishers bp ON bp.book_id = b.book_id WHERE LOWER(b.title) LIKE 'the%' AND bp.publisher_id IS NULL ORDER BY b.title; 

